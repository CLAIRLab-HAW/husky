# RViz config: MoveIt MotionPlanning against the robot's move_group
# (namespace a200_0553). Every robot-side topic/action is wired to
# /a200_0553/... . With a different namespace, view-moveit rewrites the paths
# by sed (or adjust CLEARPATH_NS).
#
# Purpose-built rather than Clearpath's stock moveit.rviz: the latter has
# 'Move Group Namespace: '' (an empty string) and relative topics -> the plugin
# connects /move_group (global, non-existent) instead of /a200_0553/move_group
# -> a recurring "Failed to get parameters" warning, no interactive marker, no
# default poses. Here ABSOLUTE paths + rviz2 global (no __ns) -> unambiguous
# name resolution.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.5
      Show Names: false
      Show Axes: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: /a200_0553
      # IMPORTANT: a bare name (no path!). MoveIt builds a helper node
      # 'rviz_ssp_robot_description' out of it and combines it with "Move Group
      # Namespace" into the topic/param /a200_0553/robot_description. A full path
      # here yields an invalid node name (a slash) -> the model does not load.
      Robot Description: robot_description
      MoveIt_Warehouse_Host: 127.0.0.1
      MoveIt_Warehouse_Port: 33829
      MoveIt_Use_Constraint_Aware_IK: false
      MoveIt_Allow_Approximate_IK: true
      MoveIt_Allow_External_Program: false
      MoveIt_Planning_Time: 5
      MoveIt_Planning_Attempts: 10
      MoveIt_Velocity_Scaling_Factor: 0.1
      MoveIt_Acceleration_Scaling_Factor: 0.1
      Planning Scene Topic: /a200_0553/monitored_planning_scene
      Scene Geometry:
        Scene Alpha: 0.9
        Show Scene Geometry: true
      Scene Robot:
        Robot Alpha: 0.5
        Show Robot Collision: false
        Show Robot Visual: true
      Planning Request:
        Colliding Link Color: 255; 0; 0
        Planning Group: arm_0
        Query Goal State: true
        Query Start State: false
        Show Workspace: false
        Interactive Marker Size: 0.2
      Planning Metrics:
        Show Joint Torques: false
        Show Weight Limit: false
      Planned Path:
        Loop Animation: false
        Show Robot Collision: false
        Show Robot Visual: true
        Show Trail: false
        State Display Time: 3x
        Trajectory Topic: /a200_0553/display_planned_path
        Interrupt Display: false
  Global Options:
    Background Color: 48; 48; 48
    # base_footprint = the ground projection under the robot (URDF chain
    # base_link -> base_footprint, z=-0.13228): the grid therefore lies on the
    # real floor and the Husky stands ON the grid instead of half inside it
    # (base_link sits 13 cm above the floor at the lower chassis edge).
    Fixed Frame: base_footprint
    Frame Rate: 30
  Tools:
    # Interact MUST be present (and active), otherwise the interactive MoveIt
    # markers cannot be grabbed -> every click only turns the camera.
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Pitch: 0.4
      Yaw: 0.8
      Name: Current View
Window Geometry:
  # Fits the 1600x900 noVNC desktop (entrypoint.sh Xvfb, NOVNC_WIDTH/HEIGHT):
  # height = 900 - 20 for the fluxbox title bar, X/Y=0 -> no clipping in the
  # browser. noVNC additionally defaults to local scaling (see the Dockerfile).
  Width: 1600
  Height: 880
  X: 0
  Y: 0
  Displays:
    collapsed: false
  MotionPlanning:
    collapsed: false