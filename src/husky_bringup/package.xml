<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>husky_bringup</name>
  <version>0.1.0</version>
  <description>
    What the a200-0553 starts beyond Clearpath's own services: the lidar's sensor path and its scan, and the octomap
    feed for move_group. Started by
    Clearpath's clearpath-platform-extras service through robot.yaml (platform.extras.launch);
    husky_extras_description is the matching description half.
  </description>
  <maintainer email="hannes.voss@haw-hamburg.de">Hannes Voss</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Run-time only: the launch includes husky_navigation's scan.launch.py, which starts the lidar's driver
       (rslidar_sdk for a RoboSense model), husky_lidar's self filter and pointcloud_to_laserscan. -->
  <exec_depend>husky_navigation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <!-- The octomap feed (setup/scripts/octomap_feed.py, installed as lib/husky_bringup/octomap_feed). -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
