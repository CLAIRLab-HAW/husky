<?xml version="1.0"?>
<!--
  The RoboSense RS-LiDAR-16 as a macro, in the shape of clearpath_sensors_description's lidar macros: ${name}_link
  on the mounting face, ${name}_laser at the optical center, the frame rslidar_sdk writes into every PointCloud2.
  Called with name="lidar3d_0", both names are the ones a Clearpath lidar3d entry would give.

  Figures from the RS-LiDAR-16 user manual (RoboSense): 0.87 kg without cable and Ø109 x 80.7 mm (§3); the lidar's
  coordinate origin at the center, 39 mm above its bottom (§8.1, note 2); ROS +x is the 0° direction, opposite the
  cable outlet (§8.1, Fig. 14 with note 1). The mesh is in the same frame (rs16_mesh.py, husky 1453d06).

  The collision is the housing's cylinder; the cable gland, 45 mm proud of it on -x, stays out.  The inertia is that
  of a homogeneous cylinder of the datasheet mass; the manual gives no center of gravity.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="rs16" params="name parent_link *origin">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0.04035"/>
        <mass value="0.87"/>
        <inertia ixx="${0.87 * (3 * 0.0545 * 0.0545 + 0.0807 * 0.0807) / 12}" ixy="0" ixz="0"
                 iyy="${0.87 * (3 * 0.0545 * 0.0545 + 0.0807 * 0.0807) / 12}" iyz="0"
                 izz="${0.87 * 0.0545 * 0.0545 / 2}"/>
      </inertial>
      <!-- No <material>: it would paint over the four colors the DAE carries. -->
      <visual>
        <geometry>
          <mesh filename="package://rs16_description/meshes/rs16.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.04035"/>
        <geometry>
          <cylinder radius="0.0545" length="0.0807"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
    </joint>

    <link name="${name}_laser"/>

    <joint name="${name}_laser_joint" type="fixed">
      <origin xyz="0 0 0.039" rpy="0 0 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_laser"/>
    </joint>
  </xacro:macro>
</robot>
