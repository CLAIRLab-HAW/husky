<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>husky_lidar</name>
  <version>0.2.0</version>
  <description>The a200-0553's lidar: its models (RS16, Qb2) and their drivers, the sensor's names, and the self filter
    that drops the robot's own points.</description>
  <maintainer email="hannes.voss@haw-hamburg.de">Hannes Voss</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- the self filter (C++): the description's collision bodies, meshes through resource_retriever -->
  <depend>geometric_shapes</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
  <depend>urdf</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- the drivers the launch starts, by model: rslidar_sdk from apt, Blickfeld's built from source (setup/'s installer) -->
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>rs16_description</exec_depend>
  <exec_depend>qb2_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
