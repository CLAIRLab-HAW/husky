<?xml version="1.0"?>
<!--
  The Robotiq 2F-85 on the UR5's flange: end_effector:=robotiq_2f_85, the tool of the gripper model of the same name
  (clair.robot.contract, profiles/grippers/robotiq_2f_85.yaml).

  GRIPPER MODEL: Clearpath's own macro (clearpath_manipulators_description, urdf/gripper/robotiq_2f_85.urdf.xacro, over
  ros-jazzy-robotiq-description), under the name clearpath_config gives an arm's gripper -  arm_0_gripper - so every
  link and joint is the one robot.yaml's manipulators.arms[0].gripper would produce.  The driver joint is
  arm_0_gripper_robotiq_85_left_knuckle_joint, 0 open to 0.8 shut; the five followers hang on it by <mimic>.
  use_controllers is false: no ros2_control block - the hand's surface is the gripper mock's in the container
  (gripper_control's gripper_sim), as for every model.

  The two frames the model file names, on the tool axis (the hand's base_link +z) at the pads' center depth by
  forward kinematics (derive_finger_kinematics.py, 2026-11-09): arm_0_gripper_hand_tcp with the hand open, 126.2 mm
  past the base, and arm_0_gripper_grasp_frame with it shut, 13.5 mm further.

  NOT MEASURED: no 2F-85 is mounted yet.  The hand sits on the flange without an adapter and unturned, and
  rg6_onrobot_rg6_base_link - the frame robot.yaml mounts the wrist camera on, which every tool file provides - stands
  where the RG6's puts it, so the camera keeps its calibrated place on the flange until a 2F-85 bracket exists.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find clearpath_manipulators_description)/urdf/gripper/robotiq_2f_85.urdf.xacro"/>
  <xacro:robotiq_2f_85 name="arm_0_gripper" parent_link="arm_0_tool0" use_controllers="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_2f_85>

  <link name="arm_0_gripper_hand_tcp"/>
  <joint name="arm_0_gripper_hand_tcp_joint" type="fixed">
    <parent link="arm_0_gripper_robotiq_85_base_link"/><child link="arm_0_gripper_hand_tcp"/>
    <origin xyz="0 0 0.126177" rpy="0 0 0"/>
  </joint>
  <link name="arm_0_gripper_grasp_frame"/>
  <joint name="arm_0_gripper_grasp_frame_joint" type="fixed">
    <parent link="arm_0_gripper_hand_tcp"/><child link="arm_0_gripper_grasp_frame"/>
    <origin xyz="0 0 0.0135" rpy="0 0 0"/>
  </joint>

  <link name="rg6_onrobot_rg6_base_link"/>
  <joint name="rg6_base_link_alias" type="fixed">
    <parent link="arm_0_tool0"/><child link="rg6_onrobot_rg6_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
  </joint>

</robot>
