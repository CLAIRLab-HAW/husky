<?xml version="1.0"?>
<!--
  The OnRobot RG6 on the UR5's flange: the a200-0553's end effector unless clearpath_extras.urdf.xacro is given
  another one (end_effector:=<name>).  Every tool file under tools/ provides the same two frames the rest of the
  robot relies on: its hand hangs on arm_0_tool0, and rg6_onrobot_rg6_base_link is where robot.yaml mounts the
  wrist camera (sensors.camera.parent, xyz 0.023/0/0.125, rpy 0/-1.5708/-3.14).

  GRIPPER MODEL:
    A cleanly articulated RG6 from package 'rg6_description' (Robotiq style:
    outer_knuckle/inner_knuckle/inner_finger per side). Driver joint =
    'rg6_finger_joint' (prefix 'rg6_'): 0 = open, positive = closed. The 5
    dependent joints hang on the driver joint via <mimic> (the official OnRobot
    multipliers) -> MoveIt animates them in the planning preview, the ROS 2
    robot_state_publisher computes them for /tf (Foxglove). The
    rg6_joint_state_broadcaster additionally publishes all 6 joints explicitly
    (fallback / live tuning of the AI2 mapping); the values match <mimic>.
    Collision = one coarse box at the base_link (no self-collision in MoveIt).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="../rg6.macro.xacro"/>
  <xacro:rg6_tool parent="arm_0_tool0"/>

  <!-- robot.yaml mounts the camera on this frame. Keep it directly on the flange so changes to the
       gripper mesh or body frame cannot move the calibrated camera mount. -->
  <link name="rg6_onrobot_rg6_base_link"/>
  <joint name="rg6_base_link_alias" type="fixed">
    <parent link="arm_0_tool0"/><child link="rg6_onrobot_rg6_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
  </joint>

  <!-- The 3D-printed L bracket between the RG6 and the D435 (the owner, 2026-10-10), silver-gray like the lidar spacer
       on the arch (sensor_arch_profiles ARCH_LOOK). Its long leg lies flat on the RG6 body's +y face (y 21.5 mm),
       screwed into the body's two front holes (M3, 3.2 mm, x +-10 mm at z 99.1 mm, read off body.stl), and runs back to
       behind the camera; there its short leg rises at right angles and takes the D435's two rear M3 screws, so the
       camera hangs on it with its underside at y 36.8 mm, where the hand-eye calibration put it. The short leg's height
       sets the 15 mm robot.yaml's mount lies off the design values; the camera's pose is robot.yaml's and nothing here
       moves it. The camera's extent is its VISUAL mesh's (d435.dae through camera_0_link, in this frame x -47.9 to
       42.0, y 36.8 to 61.9, z 63.7 to 89.5 mm, 2026-10-10), not the collision box Clearpath draws, which sits 8 mm
       further toward the fingers (z 71.7 to 97.9). The long leg is just wide enough for the two screws (28 mm, centered
       on the holes: their M3 heads, 5.5 mm, and 1.25 mm of edge, the owner, 2026-10-10); the short leg stands on its
       rear edge, 56 mm wide and centered on the camera (x -3 mm) so its rear screws, 45 mm apart, fit. Not measured:
       both legs 4 mm thick; the long leg from the short one to 5 mm past the holes; the short leg up to y 55 mm, past
       the rear screws at the camera's half height (y ~49 mm). A visual alone: it would touch the body's and the
       camera's collision geometry, and a contact the SRDF does not disable makes every MoveIt state invalid
       (ride_height_patch's lesson, 2026-09-01). -->
  <link name="camera_0_bracket">
    <!-- Both legs with their corners rounded by 3 mm, in this link's frame (tools/d435_bracket_mesh.py, which holds
         the numbers above). No <material>: the DAE carries the silver-gray. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://husky_extras_description/meshes/d435_bracket.dae"/></geometry>
    </visual>
  </link>
  <joint name="camera_0_bracket_joint" type="fixed">
    <parent link="rg6_gripper_body"/><child link="camera_0_bracket"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
