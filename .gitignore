# Python build and import artifacts.  At the REPOSITORY root, not per package: the per-package .gitignore files
# below only cover their own subtree, and the consolidation on 2026-09-03 moved several packages into trees that
# had none -- 200 .pyc files were committed that way before anyone noticed.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.coverage
.coverage.*

# Secrets.  A .env holds real credentials -- NB_SETUP_KEY for the netbird overlay, the endpoint of a running
# robot -- and belongs beside a committed .env.example, never in the history.  At the REPOSITORY root for the
# same reason as the artifacts above: until 2026-09-03 only deploy/offboard and offboard-base
# ignored the name, so any other tree that grew a .env would have committed it.
.env

# macOS Finder metadata
.DS_Store

# colcon
install/
log/
# Blickfeld's Qb2 driver, cloned and built here by the installer where robot.yaml names the Qb2
src/blickfeld_qb2_ros2_driver/

# The owner's local material: the vendor CAD the committed meshes are derived from (the rims' glTF, the charging
# connector's two STEPs), whose licenses do not allow redistributing them, and the scripts that wrote those meshes.
# The meshes are committed and nothing regenerates them; the scripts' last versioned state is husky 1453d06.
/.local/

# The owner's local tools for setup/: one-off measurements whose R point is closed (rg6_stroke_survey.py, R19), kept
# on the machine rather than shipped with the robot's checkout.  The survey's last versioned state is husky
# b15f69e.
/setup/.local/
