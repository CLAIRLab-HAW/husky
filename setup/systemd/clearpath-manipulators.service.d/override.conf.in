[Unit]
Description=Hard stop parameters for clearpath-manipulators (a clean driver shutdown)

[Service]
# R98, 2026-11-11 17:15: the PC came up before the CB3, ros2_control_node failed to configure arm_0 and died, and the
# unit ended "Deactivated successfully" (exit 0, so Restart=on-failure would not fire). Wait for the CB3 dashboard port
# instead; the '-' lets the start go on after at most 60 x 4 s, so a CB3 switched off on purpose behaves as before.
ExecStartPre=-/bin/bash -c 'for _ in {1..60}; do timeout 2 bash -c ": </dev/tcp/@ARM_ROBOT_IP@/29999" 2>/dev/null && exit 0; sleep 2; done; exit 1'
TimeoutStartSec=300
KillSignal=SIGINT
# The driver is down within 0.1 s of SIGINT ("System successfully stopped", sockets closed), but
# ros2_control_node and its ros2 launch then hang in their own teardown until SIGKILL. Measured on the
# reboot of 2026-11-11: 95 s of a 3 min 45 s reboot. 15 s keeps a wide margin over the clean part.
TimeoutStopSec=15
KillMode=control-group
SendSIGKILL=yes
# ros2_control_node puts its control thread on SCHED_FIFO via
# configure_sched_fifo() (default priority 50). Systemd units do NOT read
# /etc/security/limits.conf (pam_limits only applies to login sessions) -> without
# LimitRTPRIO that fails with EPERM and the loop runs SCHED_OTHER.
# Measured 2026-07-29: overruns at 125 Hz (cycles up to 18.5 ms).
LimitRTPRIO=99
