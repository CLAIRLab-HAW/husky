[Service]
# The start script runs `ros2 launch` in the background and waits for it, and its nodes do not end on SIGTERM:
# rslidar_sdk_node (upstream) hangs, and bt_joy_pairing did too.  With systemd's default control-group mode every
# stack restart waited 90 s for the kill, and the unit ended 'failed' (2026-11-11: stop 14:44:10, SIGKILL 14:45:40).
# mixed sends SIGTERM to the start script alone and SIGKILL to the rest at once: measured 2026-11-11, the stop took
# under a second and ended 'success'.  None of these nodes holds state that needs a clean close.  Handing the stop
# to ros2 launch instead (ExecStop with SIGINT to its PID) was tried the same day and did not end within 15 s.
KillMode=mixed
TimeoutStopSec=15
